generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum StatusObra {
  LANCAMENTO
  EM_OBRAS
  PRONTO
}

enum TipoNegocio {
  IMOVEL
  LOTE
}

enum TipoFoto {
  FACHADA
  PERSPECTIVA
  AREA_LAZER
  PLANTA
  DECORADO
  OUTRO
}

model Incorporadora {
  id              String           @id @default(cuid())
  nome            String           @unique
  construtora     String?
  logo            String?
  site            String?
  telefone        String?
  email           String?
  descricao       String?
  ativo           Boolean          @default(true)
  empreendimentos Empreendimento[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Empreendimento {
  id                  String        @id @default(cuid())
  nome                String
  incorporadoraId     String
  incorporadora       Incorporadora @relation(fields: [incorporadoraId], references: [id])
  construtora         String?
  slug                String        @unique
  ativo               Boolean       @default(false)
  bairro              String
  bairrosProximos     String[]
  endereco            String?
  cidade              String        @default("Goiânia")
  estado              String        @default("GO")
  latitude            Float?
  longitude           Float?
  precoMin            Float
  precoMax            Float
  aceitaFgts          Boolean       @default(false)
  aceitaFinanciamento Boolean       @default(true)
  programaMcmv        Boolean       @default(false)
  status              StatusObra    @default(LANCAMENTO)
  entregaPrevista     String?
  percentualObra      Int?
  diferenciais        String[]
  destaqueIa          String
  descricaoCompleta   String?
  tipoNegocio         TipoNegocio @default(IMOVEL)
  infraestrutura      String?
  areaTotalLoteamento Float?
  tipologias          Tipologia[]
  lotes               Lote[]
  fotos               Foto[]
  lotesAnuncios       LoteAnuncio[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

model Tipologia {
  id               String         @id @default(cuid())
  empreendimentoId String
  empreendimento   Empreendimento @relation(fields: [empreendimentoId], references: [id], onDelete: Cascade)
  quartos          Int
  suites           Int            @default(0)
  banheiros        Int            @default(1)
  areaPrivativa    Float
  areaTotal        Float?
  vagas            Int            @default(1)
  preco            Float
  plantaUrl        String?
  disponivel       Boolean        @default(true)
}

model Lote {
  id               String         @id @default(cuid())
  empreendimentoId String
  empreendimento   Empreendimento @relation(fields: [empreendimentoId], references: [id], onDelete: Cascade)
  quadra           String?
  numero           String?
  areaTerreno      Float
  frente           Float?
  preco            Float
  disponivel       Boolean        @default(true)
}

model Foto {
  id               String         @id @default(cuid())
  empreendimentoId String
  empreendimento   Empreendimento @relation(fields: [empreendimentoId], references: [id], onDelete: Cascade)
  url              String
  tipo             TipoFoto       @default(FACHADA)
  ordem            Int            @default(0)
  legenda          String?
}

model LoteAnuncio {
  id               String            @id @default(cuid())
  titulo           String
  slug             String            @unique
  descricao        String?
  bairro           String
  cidade           String            @default("Goiânia")
  estado           String            @default("GO")
  area             Float
  frente           Float?
  preco            Float
  fotos            LoteAnuncioFoto[]
  loteamentoId     String?
  loteamento       Empreendimento?   @relation(fields: [loteamentoId], references: [id])
  ativo            Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model LoteAnuncioFoto {
  id            String      @id @default(cuid())
  loteAnuncioId String
  loteAnuncio   LoteAnuncio @relation(fields: [loteAnuncioId], references: [id], onDelete: Cascade)
  url           String
  ordem         Int         @default(0)
  legenda       String?
}

model Lead {
  id               String     @id @default(cuid())
  nome             String
  email            String     @unique
  telefone         String
  whatsapp         String?
  status           String     @default("novo")
  orcamentoMax     Float?
  bairrosInteresse String[]
  tipoImovel       String?
  score            Int        @default(0)
  conversas        Conversa[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model Conversa {
  id                String   @id @default(cuid())
  leadId            String
  lead              Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  historicoJson     Json     @default("[]")
  resumoIa          String?
  scoreQualificacao Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  nome      String
  createdAt DateTime @default(now())
}

model Post {
  id        String   @id @default(cuid())
  titulo    String
  slug      String   @unique
  resumo    String
  conteudo  String
  capa      String?
  categoria String?
  publicado Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NewsletterLead {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  whatsapp  String
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
}
