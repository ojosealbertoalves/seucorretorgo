# Banco de dados — Supabase PostgreSQL
# Use a URL do pooler (pgbouncer) para a aplicação
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Use a URL direta para migrations (prisma migrate deploy)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase — credenciais públicas (visíveis no frontend)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."

# NextAuth — autenticação do painel admin
# Gere um secret seguro: openssl rand -base64 32
NEXTAUTH_SECRET="gere-um-secret-aleatorio-com-openssl-rand-base64-32"
# Em produção: URL do deploy no Railway
NEXTAUTH_URL="https://seu-dominio.railway.app"

# Anthropic — IA do agente Alberto
ANTHROPIC_API_KEY="sk-ant-..."
