# Banco de dados — Railway PostgreSQL
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/railway"

# Cloudflare R2 — armazenamento de imagens
CLOUDFLARE_ACCOUNT_ID="seu-account-id"
CLOUDFLARE_R2_BUCKET_NAME="nome-do-bucket"
CLOUDFLARE_R2_ACCESS_KEY_ID="sua-access-key-id"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="sua-secret-access-key"
CLOUDFLARE_R2_PUBLIC_URL="https://pub-xxxx.r2.dev"

# NextAuth — autenticação do painel admin
# Gere um secret seguro: openssl rand -base64 32
NEXTAUTH_SECRET="gere-um-secret-aleatorio-com-openssl-rand-base64-32"
# Em produção: URL do deploy no Railway
NEXTAUTH_URL="https://seu-dominio.railway.app"

# OpenRouter — IA do agente Alberto (compatível com API OpenAI)
OPENROUTER_API_KEY="sk-or-..."
OPENROUTER_MODEL="anthropic/claude-sonnet-4-5"
OPENROUTER_MODEL_FAST="anthropic/claude-haiku-4-5"
